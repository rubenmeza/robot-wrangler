# Non-secret config the Provisioner sources (ADR 0006). Rendered from this template and shipped
# base64 in the cloud-init manifest. The single-use tailnet key is NOT here -- it rides its own
# 0600 channel (/opt/robot/.ts-authkey) and is shredded after use.
ROBOT_USER=${robot_user}
GIT_AUTHOR_NAME='${git_author_name}'
GIT_AUTHOR_EMAIL=${git_author_email}
TS_HOSTNAME=${ts_hostname}
TS_TAGS=${ts_tags}
