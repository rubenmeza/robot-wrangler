# Copy to .env and fill in. .env is gitignored — never commit it.
# The scripts source this file (set -a).

# --- DigitalOcean ---
# API token used by OpenTofu (on your machine only). Create at:
#   https://cloud.digitalocean.com/account/api/tokens   (needs write scope)
export DIGITALOCEAN_TOKEN=""

# --- Tailscale ---
# One-time auth key, baked into cloud-init so the box self-joins the tailnet.
# Create at: https://login.tailscale.com/admin/settings/keys
#   Reusable: OFF   Ephemeral: OFF   Pre-approved: ON   Tags: tag:server
# (Prefixed TF_VAR_ so OpenTofu reads it directly.)
export TF_VAR_tailscale_authkey=""

# --- Claude Code ---
# Long-lived subscription token for headless use. Generate on THIS machine:
#   claude setup-token
# Pushed to the box over SSH after it joins the tailnet — never via cloud-init/metadata.
export CLAUDE_CODE_OAUTH_TOKEN=""

# --- Optional overrides (defaults shown) ---
# export TF_VAR_region="nyc3"          # or sfo3
# export TF_VAR_size="s-4vcpu-8gb"     # 8GB/4vCPU/$48
# export TF_VAR_ts_hostname="robot"
# export ROBOT_SSH_KEY="$HOME/.ssh/robot_ed25519"   # private key matching devices/arch.pub
