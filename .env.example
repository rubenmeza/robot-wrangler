# Copy to .env and fill in. .env is gitignored — never commit it.
# The scripts source this file (set -a).

# --- DigitalOcean ---
# API token used by OpenTofu (on your machine only). Create at:
#   https://cloud.digitalocean.com/account/api/tokens   (needs write scope)
export DIGITALOCEAN_TOKEN=""

# --- Tailscale ---
# One-time auth key, baked into cloud-init so the box self-joins the tailnet.
# Create at: https://login.tailscale.com/admin/settings/keys
#   Reusable: OFF   Ephemeral: OFF   Pre-approved: ON   Tags: tag:server
# (Prefixed TF_VAR_ so OpenTofu reads it directly.)
export TF_VAR_tailscale_authkey=""

# --- Claude Code ---
# Long-lived subscription token for headless use. Generate on THIS machine:
#   claude setup-token
# Pushed to the box over SSH after it joins the tailnet — never via cloud-init/metadata.
export CLAUDE_CODE_OAUTH_TOKEN=""

# --- GitHub ---
# Lets the robot act as YOU on GitHub: read issues, push branches, open PRs (see ADR 0002).
# Create a CLASSIC PAT with the single 'repo' scope, no expiry:
#   https://github.com/settings/tokens  ->  Tokens (classic)  ->  Generate new token (classic)
#   Scope: check 'repo' ONLY (not workflow / delete_repo / admin). Expiration: No expiration.
# Works across personal AND org repos with no per-org opt-in. Revoke there to kill access.
# Pushed to the box over SSH alongside the Claude token — never via cloud-init/metadata.
export GH_TOKEN=""

# --- Optional overrides (defaults shown) ---
# export TF_VAR_region="nyc3"          # or sfo3
# export TF_VAR_size="s-4vcpu-8gb"     # 8GB/4vCPU/$48
# export TF_VAR_ts_hostname="robot"
# export ROBOT_SSH_KEY="$HOME/.ssh/robot_ed25519"   # private key matching devices/arch.pub
# On-box multiplexer profile for the shared `robot` session (ADR 0003). Read by BOTH OpenTofu
# and the attach scripts, so keep it here (not just as a TF var). herdr -> attach over plain
# SSH (rich agent-state TUI); tmux -> attach over mosh (drop-proof). Both are installed either
# way; this picks the auto-attach target + transport. Change it -> destroy + re-provision.
# export TF_VAR_robot_multiplexer="herdr"   # or tmux
# Break-glass console-ONLY password for the robot user (ADR 0005). Lets you log in at DO's
# out-of-band web console when the tailnet is unreachable (e.g. a failed tailscale join). SSH
# password auth stays OFF, so it is never usable over the network. Only the HASH is stored (it
# lands in DO metadata, so never put a plaintext password here). Generate + single-quote it:
#   openssl passwd -6            # prompts, prints a $6$... hash
# Leave unset to keep the account fully password-locked (no console login).
# export TF_VAR_robot_console_password_hash='$6$REPLACE_WITH_REAL_HASH'

# --- Moshi push notifications (optional, ADR 0007) ---
# On-box moshi-hook bridges Claude Code events (task done / needs input) to Moshi push on your
# phone, even when the app is closed. Get the token in the Moshi app: Settings -> Hooks -> copy the
# pairing token. Pushed to the box over SSH alongside the other secrets; robot-auth then pairs the
# daemon and installs its user service. Leave empty to skip Moshi (the binary installs but never
# pairs/serves). Moshi Pro (multi-device push, higher rate, mosh) is redeemed IN THE APP
# (Settings -> Your License) — it is NOT a server secret and does not belong here.
# export MOSHI_PAIRING_TOKEN=""
