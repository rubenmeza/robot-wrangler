#cloud-config
# The MANIFEST: WHAT the box has on first boot (packages, user, files). All imperative HOW lives
# in the Provisioner (files/provision.sh), invoked by the single runcmd at the end. See ADR 0006.
#
# The box is already firewalled shut to the public internet here, so everything is outbound-only;
# Tailscale (brought up by the Provisioner) is what makes it reachable afterwards. Every dynamic
# payload below ships `encoding: b64`, so no non-ASCII byte can reach this YAML and void the whole
# #cloud-config the way a stray em-dash once did.

package_update: true
package_upgrade: true
packages:
  - tmux
  - mosh
  - curl
  - git
  - jq
  - ca-certificates

# Don't force a password change on first login. Without this, cloud-init's default password
# expiry marks the locked robot account "expired", which breaks the robot user's NOPASSWD sudo.
chpasswd:
  expire: false

users:
  - name: ${robot_user}
    groups: [sudo]
    shell: /bin/bash
    # Convenience passwordless sudo: acceptable because reaching this user already requires a
    # device key AND being on the tailnet. Tighten if your threat model differs.
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    # Break-glass: a console-ONLY password (ADR 0005). SSH password auth stays disabled (see
    # 99-robot-hardening.conf below), so this hash is usable only at DigitalOcean's out-of-band
    # web console, never over the network. Empty hash => stay password-locked.
%{ if console_pw_hash != "" ~}
    lock_passwd: false
    passwd: '${console_pw_hash}'
%{ else ~}
    lock_passwd: true
%{ endif ~}
    ssh_authorized_keys:
%{ for key in ssh_pubkeys ~}
      - ${key}
%{ endfor ~}

write_files:
  - path: /etc/ssh/sshd_config.d/99-robot-hardening.conf
    permissions: '0644'
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
      PubkeyAuthentication yes

  - path: /etc/needrestart/conf.d/90-noninteractive.conf
    permissions: '0644'
    content: |
      # First boot runs apt non-interactively. Without this, needrestart pops a whiptail
      # "pending kernel upgrade" dialog that fails on cloud-init's non-tty and spams the log.
      $nrconf{restart} = 'a';
      $nrconf{kernelhints} = -1;

  # Login-shell setup for the robot user: agent PATH, secret env, auto-attach (ADR 0003).
  - path: /etc/profile.d/10-robot.sh
    permissions: '0644'
    encoding: b64
    content: ${profile_d_b64}

  # The Provisioner: all imperative first-boot HOW (ADR 0006). Run as root by runcmd below.
  - path: /opt/robot/provision.sh
    permissions: '0755'
    encoding: b64
    content: ${provision_sh_b64}

  # Non-secret config the Provisioner sources.
  - path: /opt/robot/provision.env
    permissions: '0600'
    encoding: b64
    content: ${provision_env_b64}

  # Single-use tailnet auth key on its own 0600 channel. The Provisioner reads it, joins the
  # tailnet, then shreds it. Already single-use + tagged, so a leaked user_data blob yields only
  # a spent key (ADR 0001).
  - path: /opt/robot/.ts-authkey
    permissions: '0600'
    encoding: b64
    content: ${authkey_b64}

  # The Handover brief that primes every agent session (ADR terms: Handover). defer: write AFTER
  # the user exists, else cloud-init creates /home/${robot_user} as root and the robot user can't
  # write to its own home.
  - path: /home/${robot_user}/CLAUDE.md
    owner: ${robot_user}:${robot_user}
    permissions: '0644'
    encoding: b64
    content: ${claude_md_b64}
    defer: true

  # Pre-complete Claude Code's interactive onboarding so the headless TUI skips the browser OAuth
  # wizard and authenticates straight from the pushed token. defer: needs the user's home.
  - path: /home/${robot_user}/.claude.json
    owner: ${robot_user}:${robot_user}
    permissions: '0600'
    content: |
      {"hasCompletedOnboarding": true, "theme": "dark"}
    defer: true

runcmd:
  - [bash, /opt/robot/provision.sh]
